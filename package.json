{
    "name": "hydrogen-sotabosc-new",
    "private": true,
    "sideEffects": false,
    "version": "2025.7.0",
    "type": "module",
    "scripts": {
        "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 shopify hydrogen build --codegen",
        "dev": "shopify hydrogen dev --port 3030 --customer-account-push",
        "preview": "shopify hydrogen preview --build",
        "lint": "eslint --no-error-on-unmatched-pattern .",
        "codegen": "shopify hydrogen codegen && react-router typegen",
        "fetch:venue-images": "tsx scripts/fetch-venue-images.ts",
        "fetch:venue-google-photos": "tsx scripts/fetch-venue-google-photos.ts",
        "fetch:venue-google-photos:missing": "tsx scripts/fetch-venue-google-photos.ts --fill-missing",
        "draft:listing": "tsx scripts/draft-listing-from-urls.ts",
        "ingest:listing": "tsx scripts/ingest-auto-listings.ts",
        "directory:assess": "tsx scripts/filter-assess-places.ts",
        "directory:osm-import": "tsx scripts/osm-import-barcelona.ts",
        "directory:template": "tsx scripts/bulk-template-places.ts",
        "agents:draft": "tsx scripts/agents/enhanced-draft-listing.ts",
        "agents:research": "tsx scripts/agents/enhanced-draft-listing.ts --agents=research",
        "agents:competitive": "tsx scripts/agents/enhanced-draft-listing.ts --competitive",
        "agents:demo": "tsx scripts/agents/demo-agent.ts --url=https://heliogabal.com",
        "agents:enhanced": "tsx scripts/agents/enhanced-draft-listing.ts --url=https://heliogabal.com --agents=all --competitive --dry-run"
    },
    "prettier": "@shopify/prettier-config",
    "dependencies": {
        "@shopify/hydrogen": "^2025.10.1",
        "@supabase/ssr": "^0.10.2",
        "@supabase/supabase-js": "^2.104.0",
        "@tailwindcss/postcss": "^4.1.18",
        "autoprefixer": "^10.4.23",
        "framer-motion": "^12.25.0",
        "graphql": "^16.10.0",
        "graphql-tag": "^2.12.6",
        "isbot": "^5.1.22",
        "lucide-react": "^1.9.0",
        "plausible-tracker": "^0.3.9",
        "postcss": "^8.5.6",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-router": "^7.12.0",
        "react-router-dom": "^7.12.0",
        "tailwindcss": "^4.1.18",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.5",
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@graphql-codegen/cli": "^6.2.1",
        "@react-router/dev": "7.12.0",
        "@react-router/fs-routes": "7.12.0",
        "@shopify/cli": "3.85.4",
        "@shopify/hydrogen-codegen": "^0.3.3",
        "@shopify/mini-oxygen": "^3.2.1",
        "@shopify/oxygen-workers-types": "^4.1.6",
        "@shopify/prettier-config": "^1.1.2",
        "@total-typescript/ts-reset": "^0.6.1",
        "@types/eslint": "^9.6.1",
        "@types/react": "^18.2.22",
        "@types/react-dom": "^18.2.7",
        "@typescript-eslint/eslint-plugin": "^8.21.0",
        "@typescript-eslint/parser": "^8.21.0",
        "cross-env": "^10.1.0",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^3.7.0",
        "eslint-plugin-eslint-comments": "^3.2.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.11.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^5.1.0",
        "globals": "^15.14.0",
        "prettier": "^3.4.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.2",
        "vite": "^6.2.4",
        "vite-tsconfig-paths": "^4.3.1"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
