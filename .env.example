# Shopify Hydrogen (see Shopify CLI / Oxygen for the rest)
# PUBLIC_STORE_DOMAIN=
# PUBLIC_STOREFRONT_API_TOKEN=
# PRIVATE_STOREFRONT_API_TOKEN=
# SESSION_SECRET=
# PUBLIC_SITE_URL=https://sotabosc.world
# Optional pixel campus opened from /city/room/:slug (not the homepage).
# Gather.town usually cannot be iframed; WorkAdventure can.
# PUBLIC_VIRTUAL_ROOM_URL=https://play.workadventu.re/your-org/world/map

# Persistent city — public read (browser/server on Hydrogen, Living Wall nodes)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Seed → Supabase sync only (`npm run directory:sync-supabase`). Never put this on a screen or in client JS.
# SUPABASE_SERVICE_ROLE_KEY=
